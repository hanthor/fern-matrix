{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fern-matrix",
  "version": "0.1.0",
  "identifier": "com.fernmatrix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["fernmatrix"] }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/hanthor/fern-matrix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNDM3MTFGMkJBN0M3QUIKUldTcng2Y3JIM0ZEa0tSYm16TzQxTjlEZ3UxbFRBMjNGckl4a2ZPRzhwL0VGNkcrWVpSWXZhUnQK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "fern-matrix",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Matrix chat client",
    "linux": { "deb": { "depends": [] } }
  }
}
